# Copy to .env for local scripts (never commit .env). On Vercel, set the same names as environment variables.
GEMINI_API_KEY=
GEMINI_MODEL=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYER_EMAIL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Edge Function only (Supabase > Edge Functions > Secrets), together with the PayPal and Supabase values above:
PAYPAL_WEBHOOK_ID=
# Optional: salt for hashing visitor IPs in the demo limiter
IP_HASH_SALT=
